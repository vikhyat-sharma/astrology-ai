# Required — application will refuse to start without these.
DATABASE_URL=postgres://postgres:changeme@localhost:5432/astrology_ai?sslmode=disable
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# Docker Compose database credentials (used by docker-compose.yml)
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=astrology_ai

# Optional — defaults shown.
PORT=8080
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins. Empty = no cross-origin requests allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Ollama AI inference
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
